# Copie para config.env (fora do git) e preencha. Lido por run-bateria.sh.
GATEWAY_A=https://gw-a-xxxxxxxx.uc.gateway.dev
GATEWAY_B=https://gw-b-xxxxxxxx.uc.gateway.dev
GATEWAY_C=https://gw-c-xxxxxxxx.uc.gateway.dev
# região desta VM (infra/env.sh) e prefixo das contas criadas por infra/50-seed.py --prefixo
REGIAO=us-central1
EMAIL_PREFIXO=k6
# minutos sem tráfego entre os ciclos de uma bateria (fator variado na campanha)
PAUSA_CICLO_MIN=30
FIREBASE_API_KEY=
SENHA_TESTE=
# bucket dos dados brutos (infra/env.sh); vazio = não envia
BUCKET=
# 1 = apaga a cópia local depois de enviar ao bucket
APAGAR_LOCAL=0
